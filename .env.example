# ---------------------------------------------------------------------------
# VideoGeneratorApp environment template.
#
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git-ignored and MUST NEVER be committed. Every name below matches a
# field on the `Secrets` model in `src/secrets.py` (upper-cased). Values left
# blank are treated as unset. Placeholders here are intentionally fake.
# ---------------------------------------------------------------------------

# ==== LLM provider =========================================================
# Which LLM backend the agents talk to. One of:
#   gemini | groq | openrouter | openai
# `openai` means "any OpenAI-compatible /chat/completions endpoint" — see the
# LLM_BASE_URL block at the end of this file.
# You must supply the API key for whichever provider you select here.
LLM_PROVIDER=gemini
# Optional: override the model name. Blank uses the provider default
# (gemini-flash-latest). Pin one (e.g. gemini-3.8-flash) if you prefer.
# Required when LLM_PROVIDER=openai.
LLM_MODEL=
# Google Gemini API key (used when LLM_PROVIDER=gemini).
GEMINI_API_KEY=
# Groq API key (used when LLM_PROVIDER=groq).
GROQ_API_KEY=
# OpenRouter API key (used when LLM_PROVIDER=openrouter).
OPENROUTER_API_KEY=

# ==== Telegram alerts ======================================================
# Bot token from @BotFather, for topic/video-ready/publish checkpoint alerts.
TELEGRAM_BOT_TOKEN=
# Chat/user id that receives the alerts (string; may be negative for groups).
TELEGRAM_CHAT_ID=
# Optional non-Telegram alert sink (e.g. Slack/email webhook URL).
ALERT_WEBHOOK=

# ==== Stock media APIs =====================================================
# Pexels API key for stock images/clips (free tier).
PEXELS_API_KEY=
# Pixabay API key for stock images/clips (free tier).
PIXABAY_API_KEY=

# ==== YouTube per-language (optional; needed only for auto-publish) ========
# Path to / contents of the English channel OAuth client secret JSON.
YOUTUBE_CLIENT_SECRET_EN=
# Path to / contents of the Hindi channel OAuth client secret JSON.
YOUTUBE_CLIENT_SECRET_HI=

# ==== Advanced (optional) ==================================================
# Per-request HTTP timeout in seconds. LLM calls can be slow on free tiers;
# raise this if a run fails with "The read operation timed out".
HTTP_TIMEOUT=90
# Optional Pollinations "pollen" token; lifts the free 1-image/45s IP limit.
POLLINATIONS_TOKEN=

# ==== Any OpenAI-compatible LLM endpoint (LLM_PROVIDER=openai) =============
# Base URL only (the client appends /chat/completions). Examples:
#   Groq           https://api.groq.com/openai/v1
#   Cerebras       https://api.cerebras.ai/v1
#   GitHub Models  https://models.github.ai/inference
#   local vLLM     http://localhost:8000/v1
#   local Ollama   http://localhost:11434/v1
LLM_BASE_URL=
# API key for that endpoint. Local servers accept any non-empty value.
OPENAI_API_KEY=
