# Copy to `.env` and fill in. NEVER commit `.env` (public repo).

# ---- LLM ----
LLM_PROVIDER=gemini          # gemini | groq | openrouter
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- Scheduling / operating mode ----
SCHEDULE_TIME=07:00          # daily run time (IST)
CONFIRM_START=false          # true = wait for a GO before starting
PUBLISH_MODE=manual          # manual | auto
AUTO_RERUN=false             # auto one regeneration if quality score is low
MAX_ATTEMPTS=3               # cap regeneration attempts per run
AUTONOMY=full                # full | exception_only | review

# ---- Alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK=               # optional email/Slack alternative

# ---- Media providers ----
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Upload storage (optional; required only for PUBLISH_MODE=auto) ----
YOUTUBE_CLIENT_SECRET_EN=
YOUTUBE_CLIENT_SECRET_HI=
